# ==============================================================================
# AuraPure Nutrition - Production Environment Variables Configuration Template
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/aurapure_ecommerce
MONGODB_DB_NAME=aurapure_ecommerce

# JWT Security
JWT_ACCESS_SECRET=aurapure_super_secret_access_jwt_key_2026_dev_38472918374
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=aurapure_super_secret_refresh_jwt_key_2026_dev_98237489234
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=aurapure_cookie_secret_key_8374928374823974

# Razorpay Payment Gateway (Test/Live Credentials)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=aurapure_whatsapp_webhook_verify_token_secure

# Shiprocket Shipping & Logistics API
SHIPROCKET_EMAIL=your_shiprocket_email@domain.com
SHIPROCKET_PASSWORD=your_shiprocket_account_password

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@aurapure.in
SMTP_PASS=your_app_password_here
EMAIL_FROM="AuraPure Nutrition" <orders@aurapure.in>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
